{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Разрешения для главного окна и трея приложения Music Tools.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:event:default",
    "core:app:allow-version",
    "core:app:allow-name",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
