QWidget {
    background-color: #1a1a1a;
    color: #c0c0c0;
    font-size: 11pt;
    font-weight: 500;
}

QMainWindow {
    margin: 0;
    padding: 0;
    background-color: #1e1e1e;
}

QTabWidget::pane {
    padding: 10px;
    border: none;
    border-radius: 0 0 12px 12px;
    background: #2a2a2a;
}

QTabBar::tab {
    background: #1e1e1e;
    color: #f99b06;
    padding: 8px 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border: 1px solid #333;
    border-bottom: 2px solid #f99b06;
}

QTabBar::tab:selected {
    background: #2a2a2a;
    color: #c0c0c0;
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    background: #333;
    color: #b0b0b0;
;
}

QPushButton {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px 12px;
    color: #c0c0c0;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2a2a2a;
    border-color: #f99b06;
    color: #f99b06;
}

QPushButton:pressed {
    background-color: #1a1a1a;
    border-color: #f99b06;
}

QPushButton:disabled {
    color: #666;
    border-color: #333;
}

QPushButton#accentButton {
    background-color: #f99b06;
    color: #121212;
    border: none;
}

QPushButton#accentButton:hover {
    background-color: #f99b06;
}

QPushButton#accentButton:pressed {
    background-color: #f99b06;
}

QLineEdit {
    padding: 5px 8px;
}

QLineEdit, QComboBox {
    background-color: #2a2a2a;
    border: 1px solid #333;
    border-radius: 4px;
    color: #c0c0c0;
    selection-background-color: #f99b06;
    selection-color: #1a1a1a;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #f99b06;
}

QComboBox::drop-down {
    background: transparent;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QListWidget, QWidget#previewContainer {
    background-color: #1e1e1e;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    border-bottom: 1px solid #2a2a2a;
    background: #1e1e1e;
    min-height: 40px;
    border-radius: 4px;
    margin: 2px;
}

QListWidget::item:hover {
    background: #2a2a2a;
}

QListWidget QPushButton {
    background: transparent;
    border: none;
    color: #f99b06;
    font-size: 12pt;
    padding: 0;
    border-radius: 4px;
}

QListWidget QPushButton:hover {
    background-color: transparent;
    color: #f99b06;
}

QProgressBar {
    background-color: #202020;
    border: none;
    height: 12px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #f99b06, stop:1 #f5d76e);
}

QLabel {
    color: #c0c0c0;
    padding: 5px 0;
}

QLabel#titleLabel {
    font-size: 14pt;
    font-weight: bold;
    color: #f99b06;
}

QScrollBar:vertical {
    background: #1a1a1a;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #f99b06;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QWidget#titleBar {
    background-color: #1a1a1a;
}

QLabel#titleLabel {
    color: #f99b06;
    font-weight: bold;
    font-size: 14pt;
}

QPushButton#closeButton {
    background-color: transparent;
    border: none;
    color: #c0c0c0;
    font-size: 18pt;
    font-weight: bold;
    padding: 0 16px;
    min-width: 40px;
    min-height: 40px;
}

QPushButton#closeButton:hover {
    color: #e74c3c;
}

QPushButton#closeButton:pressed {
    color: #c0392b;
}

QMenu {
    border: 1px solid #3a3a3a;
    padding: 10px;
}

QMenu::item {
    padding: 8px;
    color: #c0c0c0;
    background-color: transparent;
}

QMenu::item:selected {
    border-radius: 10px;
    background-color: #3a3a3a;
}

QMenu::separator {
    height: 1px;
    background-color: #2a2a2a;
    margin: 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
}

QMenu::indicator:checked {
    image: url(icons/checkmark.png);
    width: 16px;
    height: 16px;
    padding-left: 16px;
}

QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
}

QTabWidget#tabs QWidget#aboutTab QLabel {
    color: #f99b06;
}

QTabWidget#tabs QWidget#aboutTab QPushButton {
    min-width: 150px;
    padding: 8px 20px;
}

QWidget#messageBoxMain {
    background-color: #1e1e1e;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
}

QLabel#msgTitle {
    color: #f99b06;
    font-weight: bold;
    font-size: 14pt;
}

QLabel#msgText {
    background-color: transparent;
    color: #c0c0c0;
    font-size: 11pt;
}

QPushButton#msgButton {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 6px 16px;
    color: #c0c0c0;
    font-weight: bold;
    min-width: 80px;
    margin-bottom: 16px;
}

QPushButton#msgButton:hover {
    border-color: #f99b06;
    color: #f99b06;
}

QPushButton#msgButton:pressed {
    background-color: #1a1a1a;
    border-color: #f99b06;
}